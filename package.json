{
  "name": "devortex-secret-scanner",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.devortex.secret",
    "productName": "DevVortex Secret Scanner",
    "directories": { "output": "release" },
    "linux": { "target": "AppImage" },
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" }
  }
}